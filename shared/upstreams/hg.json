{
  "as": {
    "host": "as.hypergryph.com",
    "purpose": "鹰角通行证：用账号 token 换取授权",
    "reason": "响应不带 Access-Control-Allow-Origin，POST 的 CORS 预检即失败（2026-10-16 实测）",
    "routes": [
      {
        "method": "POST",
        "path": "/user/oauth2/v2/grant",
        "limiter": "auth"
      }
    ]
  },
  "binding": {
    "host": "binding-api-account-prod.hypergryph.com",
    "purpose": "查询通行证下绑定的游戏角色，换取游戏 token",
    "reason": "响应不带 Access-Control-Allow-Origin（2026-10-16 实测：上游返回 400，仍被浏览器拦截）",
    "routes": [
      {
        "method": "GET",
        "path": "/account/binding/v1/binding_list",
        "limiter": "auth"
      },
      {
        "method": "POST",
        "path": "/account/binding/v1/u8_token_by_uid",
        "limiter": "auth"
      }
    ]
  },
  "ak": {
    "host": "ak.hypergryph.com",
    "purpose": "明日方舟官网用户中心：角色登录、寻访记录与源石记录",
    "reason": "响应不带 Access-Control-Allow-Origin（2026-10-16 实测：上游返回 401，仍被浏览器拦截）；数据接口还依赖 Cookie ak-user-center，浏览器 JS 无法设置 Cookie，也读不到 Set-Cookie",
    "relayAkCookie": true,
    "extraHeaders": {
      "referer": "https://ak.hypergryph.com/user/headhunting"
    },
    "routes": [
      {
        "method": "POST",
        "path": "/user/api/role/login",
        "limiter": "auth"
      },
      {
        "method": "GET",
        "path": "/user/api/inquiry/gacha/cate",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/user/api/inquiry/gacha/history",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/user/api/inquiry/diamond",
        "limiter": "data"
      }
    ]
  },
  "u8": {
    "host": "u8.hypergryph.com",
    "purpose": "明日方舟充值记录（官网用户中心“充值记录”页使用的接口）",
    "reason": "只允许鹰角自己的域名跨域（2026-10-16 实测：本站来源的 CORS 预检返回 204，但不带 Access-Control-Allow-Origin）",
    "routes": [
      {
        "method": "POST",
        "path": "/u8/pay/v1/recent",
        "limiter": "data"
      }
    ]
  },
  "ef": {
    "host": "ef-webview.hypergryph.com",
    "purpose": "终末地游戏内网页背后的寻访记录与卡池信息接口",
    "reason": "响应不带 Access-Control-Allow-Origin（2026-10-16 实测：上游返回 200，仍被浏览器拦截）",
    "routes": [
      {
        "method": "GET",
        "path": "/api/record/char",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/api/record/char/meta",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/api/record/char/pool",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/api/record/weapon",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/api/record/weapon/pool",
        "limiter": "data"
      },
      {
        "method": "GET",
        "path": "/api/content",
        "limiter": "data"
      }
    ]
  }
}
