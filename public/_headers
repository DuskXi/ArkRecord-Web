# Cloudflare Workers 静态资源的响应头

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data: https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# 首页：告诉 AI 助手和爬虫哪里有给它们的说明（llmstxt.org）、API 目录（RFC 9727）、接口说明和 Agent Skills
/
  Link: </llms.txt>; rel="alternate"; type="text/markdown"
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </openapi.json>; rel="service-desc"; type="application/openapi+json"
  Link: </llms-full.txt>; rel="describedby"; type="text/markdown"
  Link: </.well-known/agent-skills/index.json>; rel="agent-skills"; type="application/json"

# API 目录（RFC 9727）没有扩展名，需要指明类型
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Link: </.well-known/api-catalog>; rel="api-catalog"

# 带内容哈希的构建产物可以永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 旧版 ArkRecord（/legacy/，见 scripts/build-legacy.sh）：需要访问 api.kaltsit.dev、PRTS 等外部地址，
# 去掉新版的 CSP，改用旧版页面里单独声明的一份（脚本仍然只允许本站）。
/legacy/*
  ! Content-Security-Policy
/legacy/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 文字识别引擎和中文模型（截图识别用），路径里带版本号
/ocr/*
  Cache-Control: public, max-age=31536000, immutable

# 头像每天可能更新，缓存一周
/gamedata/avatars/*
  Cache-Control: public, max-age=604800
/gamedata/ef-avatars/*
  Cache-Control: public, max-age=604800
