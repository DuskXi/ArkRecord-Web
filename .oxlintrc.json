{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    "public/legacy",
    "node_modules",
    "worker/worker-configuration.d.ts",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "fake-indexeddb/auto"
        ]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": [
          "__APP_VERSION__",
          "__BUILD_COMMIT__",
          "__OCR_BASE__"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "desktop/electron/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
