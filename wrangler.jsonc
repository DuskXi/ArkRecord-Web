{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 顶层是测试环境（ark-next.kaltsit.dev，Worker arkrecord-next）；正式环境见下方 env.production。
  // 正式环境只由 .github/workflows/deploy-production.yml 部署（构建时设置 CLOUDFLARE_ENV=production）。
  "name": "arkrecord-next",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ark-next.kaltsit.dev", "custom_domain": true }],
  "assets": {
    // Worker 通过 env.ASSETS 取静态文件（页面地址经过 Worker 时要用）
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 只有 /api/* 和各个页面地址会执行 Worker 代码，其余静态资源直接由 Cloudflare 返回（免费、不计请求数）。
    // 页面地址经过 Worker，是为了 AI agent 要 Markdown 时返回 Markdown 说明（worker/pages.ts，列表和 PAGES 一致，测试会检查）；
    // 普通访问照常返回网页，_headers 里的响应头仍然生效。
    "run_worker_first": [
      "/api/*",
      "/",
      "/history",
      "/banners",
      "/analysis",
      "/stats",
      "/timeline",
      "/codex",
      "/ledger",
      "/data",
      "/announcements",
      "/feedback",
      "/about"
    ]
  },
  // 关闭 Workers Logs：转发请求的 URL 中可能带有用户的游戏 token（鹰角接口要求放在查询参数里），
  // 不能让平台记录它们。
  "observability": { "enabled": false },
  "ratelimits": [
    // 认证类接口（授权、绑定查询、换取 token、角色登录），按客户端 IP 计数。
    { "name": "RL_AUTH", "namespace_id": "21001", "simple": { "limit": 20, "period": 60 } },
    // 数据类接口（寻访记录、卡池信息），按客户端 IP 计数。前端同步时会主动放慢节奏，正常使用不会触发。
    { "name": "RL_DATA", "namespace_id": "21002", "simple": { "limit": 120, "period": 60 } },
    // 站内反馈：每个客户端每分钟最多 5 条
    { "name": "RL_FEEDBACK", "namespace_id": "21003", "simple": { "limit": 5, "period": 60 } },
    // 云同步：每个客户端每分钟最多 20 次（猜密码另有按账号的退避，见 worker/cloud-vault.ts）
    { "name": "RL_CLOUD", "namespace_id": "21004", "simple": { "limit": 20, "period": 60 } }
  ],
  // 匿名使用人数统计（worker/stats.ts，只保存计数器）、站内反馈（worker/feedback.ts）：各一个 Durable Object；
  // 云同步（worker/cloud-vault.ts）：每个账号一个 Durable Object，只保存浏览器加密后的密文。都用 SQLite 存储（免费版可用）。
  // 云同步还需要 Worker secret SYNC_PEPPER，无密码模式还需要 SYNC_HG_SECRET（都在 Cloudflare 后台设置，不进仓库），见 docs/rewrite/cloud-sync.md 第 18 节。
  "durable_objects": {
    "bindings": [
      { "name": "STATS", "class_name": "UsageStats" },
      { "name": "FEEDBACK", "class_name": "FeedbackStore" },
      { "name": "CLOUD", "class_name": "CloudVault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UsageStats"] },
    { "tag": "v2", "new_sqlite_classes": ["FeedbackStore"] },
    { "tag": "v3", "new_sqlite_classes": ["CloudVault"] }
  ],

  "env": {
    // 正式环境：ark.kaltsit.dev。与测试环境是两个独立的 Worker，限速计数和使用人数统计互不影响。
    "production": {
      "name": "arkrecord",
      "routes": [{ "pattern": "ark.kaltsit.dev", "custom_domain": true }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "21101", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_DATA", "namespace_id": "21102", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_FEEDBACK", "namespace_id": "21103", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_CLOUD", "namespace_id": "21104", "simple": { "limit": 20, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "STATS", "class_name": "UsageStats" },
          { "name": "FEEDBACK", "class_name": "FeedbackStore" },
          { "name": "CLOUD", "class_name": "CloudVault" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["UsageStats"] },
        { "tag": "v2", "new_sqlite_classes": ["FeedbackStore"] },
        { "tag": "v3", "new_sqlite_classes": ["CloudVault"] }
      ]
    }
  }
}
